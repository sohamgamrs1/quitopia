{
  "manifest_version": 3,
  "name": "Quitopia Blocker",
  "version": "2.0.0",
  "description": "Real, local-only website blocking for Chrome, Edge and Brave. Blocks your list in every tab, enforces safe search, and never sends anything anywhere.",
  "minimum_chrome_version": "101",
  "permissions": ["storage", "declarativeNetRequest", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quitopia Blocker"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["block.html"], "matches": ["<all_urls>"] }
  ],
  "incognito": "split",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
